--=====================================================================
-- AIM ASSIST
--=====================================================================
local Aim = {}

function Aim.find()
	local fov  = Config.Aim.Radius
	local maxD = Config.Aim.MaxDist
	local c    = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	local cp   = Camera.CFrame.Position
	local best, bd = nil, math.huge
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LP and not (Config.Aim.TeamCheck and U.ally(p)) then
			local char,_,root = U.alive(p)
			if char and (root.Position - cp).Magnitude <= maxD then
				local part = char:FindFirstChild(Config.Aim.TargetPart) or root
				local sp, on = Camera:WorldToViewportPoint(part.Position)
				if on and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
					if d <= fov and d < bd then best, bd = p, d end
				end
			end
		end
	end
	return best
end

function Aim.step(dt)
	if not Config.Aim.Enabled then return end
	local t = Aim.find()
	if not t then return end
	local char = t.Character
	if not char then return end
	local part = char:FindFirstChild(Config.Aim.TargetPart)
		or char:FindFirstChild("HumanoidRootPart")
	if not part then return end
	local goal = CFrame.new(Camera.CFrame.Position, part.Position)
	local a = math.clamp(Config.Aim.Smooth * Config.Aim.Intensity * dt * 60, 0, 1)
	Camera.CFrame = Camera.CFrame:Lerp(goal, a)
end

--=====================================================================
-- AUTO FIRE
--=====================================================================
local AutoFire = {}
local lastFire = 0

function AutoFire.step()
	if not Config.AutoFire.Enabled then return end
	if Config.AutoFire.RequireAim and not Config.Aim.Enabled then return end

	local char = LP.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool or not tool.Enabled then return end

	local target = Aim.find()
	if not target then return end

	local _,_,root = U.alive(target)
	if not root then return end

	local dist = (root.Position - Camera.CFrame.Position).Magnitude
	if dist > Config.AutoFire.MaxDist then return end

	local now = tick()
	if now - lastFire < Config.AutoFire.Delay then return end
	lastFire = now
	pcall(function() tool:Activate() end)
end

--=====================================================================
-- ESP
--=====================================================================
local ESP = {}
local tracked = {}

local function makeLine()
	return U.mk("Frame",{
		Name="LN", AnchorPoint=Vector2.new(0.5,0.5),
		BackgroundColor3=Config.ESP.Color, BorderSizePixel=0,
		Size=UDim2.fromOffset(0, 1.5), Visible=false, ZIndex=2, Parent=LineHolder})
end

function ESP.remove(p)
	local d = tracked[p]
	if not d then return end
	if d.bill and d.bill.Parent then d.bill:Destroy() end
	if d.hl   and d.hl.Parent   then d.hl:Destroy()   end
	if d.line and d.line.Parent then d.line:Destroy() end
	if d.box  and d.box.Parent  then d.box:Destroy()  end
	tracked[p] = nil
end

function ESP.clear()
	for p in pairs(tracked) do ESP.remove(p) end
end

function ESP.build(p)
	ESP.remove(p)
	local char = p.Character
	if not char or not char.Parent then return end
	local head = char:WaitForChild("Head", 3)
	local hum  = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not (head and hum and root) then return end

	local bill = U.mk("BillboardGui",{
		Name="INX_Bill", Size=UDim2.fromOffset(220,44),
		StudsOffset=Vector3.new(0,3,0), AlwaysOnTop=true,
		Adornee=head, Parent=head})

	local nameL = U.mk("TextLabel",{
		Size=UDim2.new(1,0,0,18), BackgroundTransparency=1,
		Font=Enum.Font.GothamBold, TextSize=14,
		TextStrokeTransparency=0.3, TextColor3=Config.ESP.TextColor,
		Text=p.Name, Parent=bill})

	local infoL = U.mk("TextLabel",{
		Position=UDim2.new(0,0,0,18), Size=UDim2.new(1,0,0,16),
		BackgroundTransparency=1, Font=Enum.Font.GothamMedium,
		TextSize=12, TextStrokeTransparency=0.3,
		TextColor3=Config.ESP.TextColor, Text="", Parent=bill})

	local hl = U.mk("Highlight",{
		Name="INX_HL", Adornee=char,
		FillColor=Config.ESP.Color, FillTransparency=0.75,
		OutlineColor=Config.ESP.Color, OutlineTransparency=0.25,
		DepthMode=Enum.HighlightDepthMode.AlwaysOnTop, Parent=char})

	local box
	if Config.ESP.Box then
		local hHeight = hum.HipHeight or 2
		local hSize   = (hum.RigType == Enum.HumanoidRigType.R15) and 3 or 2
		local boxSize = Vector3.new(hSize + 1.2, hHeight + 3, hSize + 1.2)
		box = U.mk("BoxHandleAdornment",{
			Name="INX_Box", Adornee=root, Size=boxSize,
			Color3=Config.ESP.Color, Transparency=0.7,
			AlwaysOnTop=true, ZIndex=5, Parent=root})
	end

	local line = makeLine()

	tracked[p] = {
		bill=bill, nameL=nameL, infoL=infoL, hl=hl, line=line, box=box,
		char=char, head=head, hum=hum, root=root,
	}
end

function ESP.step()
	if not Config.ESP.Enabled then
		if next(tracked) then ESP.clear() end
		return
	end

	local vs = Camera.ViewportSize
	local cx, cy = vs.X/2, vs.Y

	for p, d in pairs(tracked) do
		local char = p.Character
		if not char or char ~= d.char or not d.hum or d.hum.Health <= 0
			or not d.head.Parent or not d.root.Parent then
			ESP.remove(p)
			continue
		end

		if Config.ESP.TeamCheck and U.ally(p) then
			d.bill.Enabled = false
			d.hl.Enabled = false
			d.line.Visible = false
			if d.box then d.box.Visible = false end
			continue
		end

		d.bill.Enabled = true
		d.hl.Enabled = true
		d.hl.FillColor = Config.ESP.Color
		d.hl.OutlineColor = Config.ESP.Color
		if d.box and d.box.Parent then
			d.box.Visible = true
			d.box.Color3 = Config.ESP.Color
		end

		d.nameL.Visible = Config.ESP.Name
		d.nameL.Text = p.Name
		d.nameL.TextColor3 = Config.ESP.TextColor

		local dist = (d.root.Position - Camera.CFrame.Position).Magnitude
		local txt = {}
		if Config.ESP.Dist   then table.insert(txt, string.format("%dm", math.floor(dist))) end
		if Config.ESP.Health then table.insert(txt, string.format("%d HP", math.floor(d.hum.Health))) end
		d.infoL.Text = table.concat(txt, "  |  ")
		d.infoL.Visible = #txt > 0
		d.infoL.TextColor3 = Config.ESP.TextColor

		if Config.ESP.Line then
			local wp, on = Camera:WorldToViewportPoint(d.head.Position + Vector3.new(0,1.2,0))
			if on and wp.Z > 0 then
				local from = Vector2.new(cx, cy)
				local to   = Vector2.new(wp.X, wp.Y)
				local diff = to - from
				local len  = diff.Magnitude
				local mid  = (from + to)/2
				local ang  = math.deg(math.atan2(diff.Y, diff.X))
				d.line.Visible  = true
				d.line.Position = UDim2.fromOffset(mid.X, mid.Y)
				d.line.Size     = UDim2.fromOffset(math.max(len,1), 1.5)
				d.line.Rotation = ang
				d.line.BackgroundColor3 = Config.ESP.Color
				d.line.BackgroundTransparency = 0.15
			else
				d.line.Visible = false
			end
		else
			d.line.Visible = false
		end
	end
end

--=====================================================================
-- PLAYER TRACKING
--=====================================================================
local function bindPlayer(p)
	if p == LP then return end
	p.CharacterAdded:Connect(function()
		task.wait(0.35)
		if Config.ESP.Enabled then ESP.build(p) end
	end)
	p.CharacterRemoving:Connect(function() ESP.remove(p) end)
	if p.Character and Config.ESP.Enabled then
		task.spawn(function()
			task.wait(0.35)
			if Config.ESP.Enabled and p.Character then ESP.build(p) end
		end)
	end
end

for _,p in ipairs(Players:GetPlayers()) do bindPlayer(p) end
Players.PlayerAdded:Connect(bindPlayer)
Players.PlayerRemoving:Connect(function(p) ESP.remove(p) end)

