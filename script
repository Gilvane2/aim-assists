	for i,opt in ipairs(options) do
		local b = U.mk("TextButton",{
			Position=UDim2.new((i-1)/n, 2, 0, 2),
			Size=UDim2.new(1/n, -4, 1, -4),
			BackgroundColor3=Color3.fromRGB(30,30,42),
			Text=tostring(opt), Font=Enum.Font.GothamBold,
			TextSize=12, TextColor3=SUB,
			AutoButtonColor=false, Parent=bar})
		U.corner(b, 6)
		b.MouseButton1Click:Connect(function() set(opt); refresh() end)
		btns[opt] = b
	end
	refresh()
	return row
end

