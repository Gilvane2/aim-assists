		BackgroundColor3=Color3.fromRGB(30,30,42),
		BorderSizePixel=0, Parent=row})
	U.corner(bar, 8)

	local btns = {}
	local n = #options
	local function refresh()
		local cur = get()
		for i,opt in ipairs(options) do
