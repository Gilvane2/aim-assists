local dgB, dStart, sPos
FB.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
		dgB=true; dStart=i.Position; sPos=FB.Position
	end
end)
UIS.InputChanged:Connect(function(i)
	if not dgB then return end
	if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement then
		local d = i.Position - dStart
		FB.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset+d.X, sPos.Y.Scale, sPos.Y.Offset+d.Y)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
		if dgB then
			local moved = (i.Position - dStart).Magnitude
			dgB=false
			if moved < 8 then
				Config.Aim.Enabled = not Config.Aim.Enabled
				refreshFOV(); updateFB()
			end
		end
	end
end)

