local function newSlider(parent,label,minV,maxV,get,set)
	local row = U.mk("Frame",{
		Size=UDim2.new(1,0,0,36), BackgroundTransparency=1, Parent=parent})
	local lbl = U.mk("TextLabel",{
		Size=UDim2.new(1,0,0,16), BackgroundTransparency=1,
		Text=label..": "..tostring(get()),
		Font=Enum.Font.GothamMedium, TextSize=12, TextColor3=TXT,
		TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
	local track = U.mk("TextButton",{
		Position=UDim2.new(0,0,1,-12), Size=UDim2.new(1,0,0,6),
		BackgroundColor3=Color3.fromRGB(40,40,55), Text="",
		AutoButtonColor=false, Parent=row})
	U.corner(track, 3)
	local fill = U.mk("Frame",{
		Size=UDim2.new(0,0,1,0), BackgroundColor3=ACC,
		BorderSizePixel=0, Parent=track})
	U.corner(fill, 3)
	U.mk("UIGradient",{Color=ColorSequence.new(ACC, ACC2), Parent=fill})

	local function setX(px)
		local rel = math.clamp((px - track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
		local v = minV + (maxV-minV)*rel
		v = (maxV-minV)>=20 and math.floor(v+0.5) or math.floor(v*100+0.5)/100
		set(v); lbl.Text = label..": "..tostring(v)
		fill.Size = UDim2.new(rel,0,1,0)
	end
	local rel0 = math.clamp((get()-minV)/(maxV-minV), 0, 1)
	fill.Size = UDim2.new(rel0,0,1,0)

	local dr=false
	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			dr=true; setX(i.Position.X)
		end
	end)
	track.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=false end
	end)
	UIS.InputChanged:Connect(function(i)
		if dr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
			setX(i.Position.X)
		end
	end)
end

