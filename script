local function toggleWin()
	Win.Visible = not Win.Visible
	if Win.Visible then
		Win.Size = UDim2.fromOffset(0,0)
		TweenService:Create(Win, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = isMobile and UDim2.fromOffset(340,470) or UDim2.fromOffset(560,520),
		}):Play()
	end
end

closeB.MouseButton1Click:Connect(function()
	TweenService:Create(Win, TweenInfo.new(0.15), {Size=UDim2.fromOffset(0,0)}):Play()
	task.delay(0.15, function() Win.Visible=false end)
end)

UIS.InputBegan:Connect(function(i,g)
	if g then return end
	if i.KeyCode == Enum.KeyCode.RightControl then toggleWin() end
end)

local lpT
FB.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch then
		lpT = task.delay(0.55, function() toggleWin(); dgB=false end)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.Touch and lpT then
		task.cancel(lpT); lpT=nil
	end
end)

