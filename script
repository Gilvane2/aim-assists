--=====================================================================
-- UTIL
--=====================================================================
local U = {}

function U.mk(class, props)
	local i = Instance.new(class)
	local parent
	for k,v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			pcall(function() i[k] = v end)
		end
	end
	if parent then i.Parent = parent end
	return i
end

function U.corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = p
	return c
end

function U.stroke(p, c, t, tr)
	local s = Instance.new("UIStroke")
	s.Color = c or Color3.fromRGB(55,55,70)
	s.Thickness = t or 1
	s.Transparency = tr or 0
	pcall(function() s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border end)
	s.Parent = p
	return s
end

function U.ally(p)
	return p.Team ~= nil and p.Team == LP.Team
end

function U.alive(p)
	local c = p.Character
	if not c or not c.Parent then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if not h or not r or h.Health <= 0 then return nil end
	return c, h, r
end

